<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login | GLBITM Hostel Complaint Portal</title>
  <link rel="stylesheet" href="/theme.css" />
  <style>
    .auth { min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr; }
    .auth-brand { padding: 56px 64px; display: flex; flex-direction: column; justify-content: space-between; background: var(--surface); border-right: 1px solid var(--border); }
    .logo-tile { display: inline-flex; background: none; padding: 0; }
    .logo-tile img { height: 150px; width: auto; max-width: 100%; object-fit: contain; display: block; }
    .auth-brand h1 { font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.1; margin: 28px 0 16px; }
    .auth-brand h1 em { font-style: normal; color: var(--accent); }
    .auth-brand p { max-width: 420px; }
    .auth-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
    .auth-steps li { display: flex; gap: 12px; align-items: baseline; color: var(--muted); }
    .auth-steps b { color: var(--accent); font-family: var(--font-head); }
    .auth-form-wrap { display: flex; align-items: center; justify-content: center; padding: 32px 20px; }
    .auth-form { width: 100%; max-width: 400px; }
    .auth-form h2 { font-size: 1.8rem; margin: 0 0 6px; }
    .auth-form .group { margin-top: 18px; }
    .alert { margin: 20px 0 0; padding: 10px 14px; border-radius: 10px; font-size: 0.9rem; color: var(--danger); background: rgba(240, 97, 109, 0.12); border: 1px solid rgba(240, 97, 109, 0.35); }
    .mobile-logo { display: none; margin-bottom: 24px; }
    .auth-links { margin-top: 24px; display: grid; gap: 8px; font-size: 0.9rem; color: var(--muted); }
    @media (max-width: 900px) {
      .auth { grid-template-columns: 1fr; }
      .auth-brand { display: none; }
      .mobile-logo { display: block; }
      .logo-tile img { height: 110px; }
    }
  </style>
</head>
<body class="theme">
  <div class="auth">

    <aside class="auth-brand">
      <div>
        <span class="logo-tile"><img src="/college-logo.png" alt="GLBITM logo" /></span>
        <h1>Hostel problems, <em>tracked</em> until they are fixed.</h1>
        <p class="muted">Report an issue, see who else is affected, and follow it until the warden resolves it.</p>
      </div>
      <ol class="auth-steps">
        <li><b>01</b> Register your complaint with a photo</li>
        <li><b>02</b> Urgent issues rise automatically if ignored</li>
        <li><b>03</b> Rate the fix, or reopen it if it still persists</li>
      </ol>
    </aside>

    <main class="auth-form-wrap">
      <form class="auth-form" action="/user/login" method="POST">
        <div class="mobile-logo"><span class="logo-tile"><img src="/college-logo.png" alt="GLBITM logo" /></span></div>

        <h2>Welcome back</h2>
        <p class="muted" style="margin:0">Log in with your scholar number.</p>

        <% if (typeof message !== "undefined" && message) { %>
          <div class="alert" role="alert"><%= message %></div>
        <% } %>

        <div class="group">
          <label class="label" for="scholarNumber">Scholar number</label>
          <input class="field" id="scholarNumber" name="scholarNumber" type="number" placeholder="Enter your scholar number" autocomplete="username" />
        </div>

        <div class="group">
          <label class="label" for="password">Password</label>
          <input class="field" id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" />
        </div>

        <button class="btn btn-primary" style="width:100%;margin-top:24px">Log in</button>

        <div class="auth-links">
          <span>New here? <a href="/user/register">Create an account</a></span>
          <span>Hostel admin? <a href="/admin/login">Admin login</a></span>
        </div>
      </form>
    </main>

  </div>
</body>
</html>