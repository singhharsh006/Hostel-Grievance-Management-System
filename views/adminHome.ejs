<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin dashboard | GLBITM Hostel Complaint Portal</title>
  <link rel="stylesheet" href="/theme.css" />
</head>

<body class="theme">

  <%- include('partials/adminNavbar', { active: 'dash' }) %>

  <main class="page dh-main">
    <div class="page-head">
      <div>
        <h1>Admin dashboard</h1>
        <p class="muted" id="hostelLine">Complaints from your hostel</p>
      </div>
      <div class="toolbar">
        <button type="button" id="csvBtn" class="btn btn-ghost">Download CSV</button>
        <a class="btn btn-primary" href="/admin/analytics">Analytics</a>
      </div>
    </div>

    <div class="ad-stats">
      <div class="dh-stat accent"><b id="stOpen">0</b><span>Not resolved</span></div>
      <div class="dh-stat"><b id="stProg">0</b><span>In progress</span></div>
      <div class="dh-stat"><b id="stDone">0</b><span>Resolved</span></div>
      <div class="dh-stat"><b id="stRating">-</b><span>Average rating</span></div>
    </div>

    <div id="recentComplaints" class="ar-list"></div>
  </main>

  <footer class="pagefoot">
    <div class="wrap">
      Developed by <strong>Harsh Kumar Singh</strong><br />
      GL Bajaj Institute of Technology &amp; Management, Greater Noida
    </div>
  </footer>

  <%- include('partials/complaintHelpers') %>

  <script>
    // "<" is escaped so a complaint containing a closing script tag cannot break out of it
    const user = <%- JSON.stringify(user || {}).replace(/</g, "\\u003c") %>;
    const complaints = <%- JSON.stringify(complaints || []).replace(/</g, "\\u003c") %>;

    // ---------- Dark-theme overrides of the shared helper functions ----------
    const svg = (d) => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg>';
    const ICON_USER = svg('<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>');
    const ICON_ROOM = svg('<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M10 21v-6h4v6"/>');
    const ICON_DATE = svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>');
    const ICON_PHONE = svg('<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>');

    function getCategoryIcon(category) {
      switch (category) {
        case "water": return svg('<path d="M12 2C8 7 5 10 5 14a7 7 0 0 0 14 0c0-4-3-7-7-12z"/>');
        case "electricity": return svg('<path d="M13 10V3L4 14h7v7l9-11h-7z"/>');
        case "network": return svg('<path d="M5.05 12.55a8 8 0 0 1 13.9 0"/><path d="M8.46 15.16a4 4 0 0 1 7.07 0"/><path d="M12 18.5h.01"/>');
        case "mess": return svg('<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/>');
        case "washroom": return svg('<circle cx="12" cy="12" r="10"/><rect x="6" y="14" width="12" height="4" rx="2"/><path d="M9 14v-2M15 14v-2"/>');
        default: return svg('<circle cx="12" cy="12" r="10"/>');
      }
    }

    function priorityBadge(comp) {
      return '<span class="pri">' + esc(priorityOf(comp)) + ' priority</span>';
    }

    function statusPill(status) {
      if (status === "resolved") return '<span class="badge badge-done">Resolved</span>';
      if (status === "in progress") return '<span class="badge badge-progress">In progress</span>';
      return '<span class="badge badge-open">Not resolved</span>';
    }

    function photoBlock(comp) {
      const before = safeImg(comp.image);
      const after = safeImg(comp.resolutionImage);
      if (!before && !after) return "";
      const one = (src, label) => `
        <a href="${esc(src)}" target="_blank" rel="noopener">
          <img src="${esc(src)}" alt="${label}" loading="lazy" />
          ${label}
        </a>`;
      return `<div class="mc-photos">
        ${before ? one(before, "Complaint photo") : ""}
        ${after ? one(after, "After resolution") : ""}
      </div>`;
    }

    function adminNoteBlock(comp) {
      if (!comp.adminNote) return "";
      return `<div class="mc-note"><strong>Admin note:</strong> ${esc(comp.adminNote)}</div>`;
    }

    function buildFilterBar(selectClass, defaultSort) {
      const wrap = document.createElement("div");
      wrap.className = "mc-filters";
      wrap.innerHTML = `
        <input id="searchBox" type="search" class="field search" placeholder="Search by title, description, name or room..." />
        <div class="mc-filter-row">
          <div><label for="categoryFilter" class="label">Category</label>
            <select id="categoryFilter" class="field">
              <option value="all">All</option>
              <option value="water">Water</option>
              <option value="electricity">Electricity</option>
              <option value="network">Network</option>
              <option value="mess">Mess</option>
              <option value="washroom">Washroom</option>
              <option value="general">General</option>
            </select></div>
          <div><label for="statusFilter" class="label">Status</label>
            <select id="statusFilter" class="field">
              <option value="all">All</option>
              <option value="not resolved">Not resolved</option>
              <option value="in progress">In progress</option>
              <option value="resolved">Resolved</option>
            </select></div>
          <div><label for="priorityFilter" class="label">Priority</label>
            <select id="priorityFilter" class="field">
              <option value="all">All</option>
              <option value="Urgent">Urgent</option>
              <option value="High">High</option>
              <option value="Medium">Medium</option>
              <option value="Low">Low</option>
            </select></div>
          <div><label for="sortBy" class="label">Sort by</label>
            <select id="sortBy" class="field">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="priority">Highest priority</option>
              <option value="affected">Most affected</option>
            </select></div>
        </div>
        <p id="resultCount" class="mc-count"></p>`;
      wrap.querySelector("#sortBy").value = defaultSort;
      return wrap;
    }

    // Reopen badge + student's rating, shown on each complaint
    function feedbackSummary(comp) {
      const parts = [];

      if (Number(comp.reopenCount) > 0) {
        const when = comp.reopenedAt
          ? new Date(comp.reopenedAt).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })
          : "";
        parts.push(`<div>
          <span class="mc-reopen">Reopened ${Number(comp.reopenCount)}x${when ? " (last: " + when + ")" : ""}</span>
          ${comp.reopenReason ? `<p class="mc-reason">Student says: ${esc(comp.reopenReason)}</p>` : ""}
        </div>`);
      }

      if (comp.status === "resolved") {
        const stars = Number(comp.rating) || 0;
        parts.push(stars
          ? `<div>
               <p class="mc-title">Student rating</p>
               <div class="mc-stars-done">
                 <span class="on">${"★".repeat(stars)}</span><span class="off">${"★".repeat(5 - stars)}</span><small>${stars}/5</small>
               </div>
               ${comp.feedback ? `<p class="mc-reason">${esc(comp.feedback)}</p>` : ""}
             </div>`
          : `<p class="mc-reason" style="margin:0">Not rated by the student yet.</p>`);
      }

      return parts.length ? `<div class="mc-extra">${parts.join("")}</div>` : "";
    }

    function confirmResolve() {
      return confirm("Are you sure you want to mark this complaint as resolved?");
    }

    function option(value, current, label) {
      return `<option value="${value}" ${value === current ? "selected" : ""}>${label || value}</option>`;
    }

    // ---------- Page ----------
    const recentComplaints = document.getElementById("recentComplaints");

    // Search + filters, placed above the list. Admin default sort = highest priority first.
    recentComplaints.parentNode.insertBefore(buildFilterBar("", "priority"), recentComplaints);

    if (user.hostel_no) {
      document.getElementById("hostelLine").textContent = "Complaints from " + user.hostel_no;
    }

    // Stat tiles (all complaints, not affected by the filters)
    (function () {
      const set = (id, v) => { document.getElementById(id).textContent = v; };
      set("stOpen", complaints.filter(c => c.status === "not resolved").length);
      set("stProg", complaints.filter(c => c.status === "in progress").length);
      set("stDone", complaints.filter(c => c.status === "resolved").length);
      const rated = complaints.map(c => Number(c.rating)).filter(r => r > 0);
      set("stRating", rated.length ? (rated.reduce((a, b) => a + b, 0) / rated.length).toFixed(1) + " / 5" : "-");
    })();

    function renderComplaints() {
      const f = getFilters();
      const list = sortComplaints(complaints.filter(c => matchesFilters(c, f)), f.sort);

      recentComplaints.innerHTML = "";
      setResultCount(list.length, complaints.length);

      if (list.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.innerHTML = complaints.length === 0
          ? "<h3>No complaints yet</h3><p>Nobody in this hostel has raised a complaint.</p>"
          : "<h3>No matches</h3><p>No complaints match your search or filters.</p>";
        recentComplaints.appendChild(empty);
        return;
      }

      list.forEach(comp => {
        const u = comp.user || {};
        const id = esc(comp._id);
        const priority = priorityOf(comp);
        const affected = Array.isArray(comp.upvotes) ? comp.upvotes.length : 0;

        const quickResolve = comp.status === "resolved"
          ? ""
          : `<form action="/admin/resolve/${id}" method="POST" onsubmit="return confirmResolve()">
               <button type="submit" class="btn btn-sm btn-primary">Mark as resolved</button>
             </form>`;

        const updatePanel = `
          <details>
            <summary>Update status, priority, note or photo</summary>
            <form action="/admin/resolve/${id}" method="POST" enctype="multipart/form-data" class="ar-panel">
              <p class="ar-full">${esc(comp.description)}</p>
              <div class="ar-two">
                <label>Status
                  <select name="status" class="field">
                    ${option("not resolved", comp.status, "Not resolved")}
                    ${option("in progress", comp.status, "In progress")}
                    ${option("resolved", comp.status, "Resolved")}
                  </select>
                </label>
                <label>Priority
                  <select name="priority" class="field">
                    ${["Urgent", "High", "Medium", "Low"].map(p => option(p, priority)).join("")}
                  </select>
                </label>
              </div>
              <label>Note for the student
                <textarea name="adminNote" rows="2" class="field">${esc(comp.adminNote || "")}</textarea>
              </label>
              <label>After-resolution photo (JPG, PNG or WEBP, up to 2 MB)
                <input type="file" name="resolutionImage" accept="image/jpeg,image/png,image/webp" class="field" />
              </label>
              <button type="submit" class="btn btn-primary">Save update</button>
            </form>
          </details>`;

        const row = document.createElement("article");
        row.className = "ar ar-" + priority.toLowerCase();
        row.innerHTML = `
          <div class="ar-main">
            <div>
              <h2 class="ar-title">${esc(comp.title)}</h2>
              <p class="ar-desc">${esc(comp.description)}</p>
            </div>
            <div class="ar-badges">
              <span class="badge badge-cat mc-cat">${getCategoryIcon(comp.category)}${esc(comp.category)}</span>
              ${statusPill(comp.status)}
              ${priorityBadge(comp)}
            </div>
          </div>
          ${photoBlock(comp)}
          ${adminNoteBlock(comp)}
          <div class="ar-meta">
            <span>${ICON_USER}${esc(u.username)}</span>
            <span>${ICON_ROOM}${esc(comp.hostel_no)} &middot; Room ${esc(u.room_no)}</span>
            <span>${ICON_PHONE}${esc(u.phone)}</span>
            <span>${ICON_DATE}${formatDate(comp.createdAt)}</span>
          </div>
          ${(quickResolve || affected > 0) ? `<div class="ar-actions">
            ${quickResolve}
            ${affected > 0 ? `<span class="ar-affected">${affected} more student(s) also affected</span>` : ""}
          </div>` : ""}
          ${updatePanel}
        `;
        row.insertAdjacentHTML("beforeend", feedbackSummary(comp));
        recentComplaints.appendChild(row);
      });
    }

    // ---------- CSV export: downloads the complaints currently shown (after search and filters) ----------
    function csvCell(v) {
      let s = String(v ?? "");
      // stop Excel from running text that starts with = + - @ as a formula
      if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
      return '"' + s.replace(/"/g, '""') + '"';
    }

    function csvDate(v) {
      return v ? new Date(v).toLocaleDateString("en-CA") : "";
    }

    function buildCsv(list) {
      const header = ["Title", "Category", "Status", "Priority", "Student", "Room", "Hostel",
        "Created", "Resolved", "Rating", "Times reopened", "Description"];
      const rows = list.map(c => {
        const u = c.user || {};
        return [c.title, c.category, c.status, c.priority || "", u.username || "", u.room_no || "",
          c.hostel_no, csvDate(c.createdAt), csvDate(c.resolvedAt), c.rating || "",
          Number(c.reopenCount) || 0, c.description];
      });
      return [header, ...rows].map(r => r.map(csvCell).join(",")).join("\r\n");
    }

    function downloadCsv() {
      const f = getFilters();
      const list = sortComplaints(complaints.filter(c => matchesFilters(c, f)), f.sort);
      if (list.length === 0) {
        alert("No complaints to export with the current filters.");
        return;
      }
      // \uFEFF makes Excel read the file as UTF-8 (Hindi and special characters stay correct)
      const blob = new Blob(["\uFEFF" + buildCsv(list)], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "complaints-" + new Date().toLocaleDateString("en-CA") + ".csv";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    document.getElementById("csvBtn").addEventListener("click", downloadCsv);

    watchFilters(renderComplaints);
    renderComplaints();
  </script>

  <% if (typeof message !== "undefined" && message) { %>
  <script>
    window.onload = function () {
      alert(<%- JSON.stringify(message).replace(/</g, "\\u003c") %>);
    }
  </script>
  <% } %>

</body>

</html>