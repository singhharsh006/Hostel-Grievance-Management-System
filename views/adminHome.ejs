<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hostel Complaint Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-red-50 min-h-screen flex flex-col items-center py-10">
    <div>
        <div class="absolute top-4 right-4">
            <form action="/user/logout" method="POST" class="inline">
                <button type="submit" class="text-red-500 font-bold py-2 px-4 ">
                    Logout
                </button>
            </form>
        </div>
    </div>
    <img src="/college-logo.png" alt="Hostel Complaint Portal Logo" class="mb-6 w-40 h-40 object-contain" />
    <h1 class="mb-5 text-center text-2xl text-red-700 sm:text-3xl font-bold">
        Hostel Complaint Portal Admin
    </h1>

    <!-- Buttons -->
    <div class="hidden sm:flex flex-row justify-center gap-4 w-full sm:w-auto px-4">
        <button id="recentComplaintBtn"
            class="tab-btn bg-red-600 text-white border border-blue-600 px-6 py-3 rounded-lg shadow">
            Recent Complaints
        </button>
    </div>

    <!-- Recent Complaints List -->
    <div id="recentComplaints" class="mt-6 w-full max-w-4xl p-6 space-y-10">
        <!-- Cards will be inserted here -->
    </div>

    <%- include('partials/complaintHelpers') %>

    <script>
                // Reopen badge + student's rating, shown on each complaint card
        function feedbackSummary(comp) {
            const parts = [];

            if (Number(comp.reopenCount) > 0) {
                const when = comp.reopenedAt
                    ? new Date(comp.reopenedAt).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })
                    : "";
                parts.push(`<div>
                  <span class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full font-semibold">Reopened ${Number(comp.reopenCount)}x${when ? " (last: " + when + ")" : ""}</span>
                  ${comp.reopenReason ? `<p class="text-gray-700 mt-2">Student says: ${esc(comp.reopenReason)}</p>` : ""}
                </div>`);
            }

            if (comp.status === "resolved") {
                const stars = Number(comp.rating) || 0;
                parts.push(stars
                    ? `<div>
                         <p class="font-semibold text-gray-700">Student rating</p>
                         <div class="text-2xl leading-none">
                           <span class="text-yellow-400">${"★".repeat(stars)}</span><span class="text-gray-300">${"★".repeat(5 - stars)}</span>
                           <span class="text-sm text-gray-600 ml-2 align-middle">${stars}/5</span>
                         </div>
                         ${comp.feedback ? `<p class="text-gray-600 mt-1">${esc(comp.feedback)}</p>` : ""}
                       </div>`
                    : `<p class="text-gray-400">Not rated by the student yet.</p>`);
            }

            return parts.length
                ? `<div class="mt-4 pt-4 border-t border-gray-200 text-sm space-y-3">${parts.join("")}</div>`
                : "";
        }
        function confirmResolve() {
            return confirm("Are you sure you want to mark this complaint as resolved?");
        }

        const user = <%- JSON.stringify(user || {}).replace(/</g, "\\u003c") %>;
        const complaints = <%- JSON.stringify(complaints || []).replace(/</g, "\\u003c") %>;

        const recentComplaints = document.getElementById("recentComplaints");

        // Search + filters, placed above the list. Admin default sort = highest priority first.
        recentComplaints.parentNode.insertBefore(
            buildFilterBar("bg-red-300 text-black", "priority"),
            recentComplaints
        );

        function option(value, current, label) {
            return `<option value="${value}" ${value === current ? "selected" : ""}>${label || value}</option>`;
        }

        function renderComplaints() {
            const f = getFilters();
            const list = sortComplaints(complaints.filter(c => matchesFilters(c, f)), f.sort);

            recentComplaints.innerHTML = "";
            setResultCount(list.length, complaints.length);

            if (list.length === 0) {
                const none = document.createElement("p");
                none.className = "text-red-500 text-center mt-6";
                none.textContent = "No complaints match your search or filters.";
                recentComplaints.appendChild(none);
                return;
            }

            list.forEach(comp => {
                const u = comp.user || {};
                const id = esc(comp._id);
                const priority = priorityOf(comp);

                const quickResolve = comp.status === "resolved"
                    ? statusPill("resolved")
                    : `<div class="flex flex-wrap items-center gap-2 mt-2 sm:mt-0">
                         ${comp.status === "in progress" ? statusPill("in progress") : ""}
                         <form action="/admin/resolve/${id}" method="POST" onsubmit="return confirmResolve()">
                           <button type="submit" class="bg-red-100 text-yellow-700 px-4 py-1 rounded-full font-bold shadow hover:bg-red-200">
                             Mark as resolved
                           </button>
                         </form>
                       </div>`;

                const updatePanel = `
                  <details class="mt-6 border-t border-gray-200 pt-4">
                    <summary class="cursor-pointer font-semibold text-red-700">Update status, priority, note or photo</summary>
                    <form action="/admin/resolve/${id}" method="POST" enctype="multipart/form-data" class="mt-4 space-y-3">
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="text-sm font-medium text-gray-700">Status
                          <select name="status" class="mt-1 w-full border border-gray-300 rounded p-2">
                            ${option("not resolved", comp.status, "Not resolved")}
                            ${option("in progress", comp.status, "In progress")}
                            ${option("resolved", comp.status, "Resolved")}
                          </select>
                        </label>
                        <label class="text-sm font-medium text-gray-700">Priority
                          <select name="priority" class="mt-1 w-full border border-gray-300 rounded p-2">
                            ${["Urgent", "High", "Medium", "Low"].map(p => option(p, priority)).join("")}
                          </select>
                        </label>
                      </div>
                      <label class="block text-sm font-medium text-gray-700">Note for the student
                        <textarea name="adminNote" rows="2" class="mt-1 w-full border border-gray-300 rounded p-2">${esc(comp.adminNote || "")}</textarea>
                      </label>
                      <label class="block text-sm font-medium text-gray-700">After-resolution photo (JPG, PNG or WEBP, up to 2 MB)
                        <input type="file" name="resolutionImage" accept="image/jpeg,image/png,image/webp"
                          class="mt-1 w-full border border-gray-300 rounded p-2 text-sm bg-gray-50" />
                      </label>
                      <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">Save update</button>
                    </form>
                  </details>`;

                const card = document.createElement("div");
                card.className = "max-w-full sm:max-w-xl mx-auto p-6 sm:p-8 bg-white rounded-xl shadow-xl border border-gray-200 relative";
                card.innerHTML = `
                  <div class="flex flex-wrap justify-between items-center mb-4">
                    <div class="flex items-center space-x-2 bg-blue-100 text-blue-700 px-3 py-1 rounded-full font-semibold shadow">
                      <span class="inline-block">${getCategoryIcon(comp.category)}</span>
                      <span>${esc(comp.category)}</span>
                    </div>
                    ${quickResolve}
                  </div>

                  <div class="flex justify-center mb-4">${priorityBadge(comp)}</div>

                  <h2 class="text-2xl sm:text-4xl font-extrabold text-gray-900 text-center mb-6 break-words">${esc(comp.title)}</h2>

                  <p class="text-gray-700 text-base sm:text-lg leading-relaxed mb-8 px-4 text-center max-w-full sm:max-w-xl mx-auto whitespace-pre-line break-words">${esc(comp.description)}</p>

                  ${photoBlock(comp)}
                  ${adminNoteBlock(comp)}

                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 text-gray-800 text-sm sm:text-base px-4 sm:px-8">
                    <div class="flex items-center space-x-2">
                      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A8.959 8.959 0 0112 15a8.959 8.959 0 016.879 2.804M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <strong>${esc(u.username)}</strong>
                    </div>
                    <div class="flex items-center space-x-2">
                      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 14h10M9 18h6" />
                      </svg>
                      <strong>${esc(comp.hostel_no)}</strong>
                    </div>
                    <div class="flex items-center space-x-2">
                      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 21h16V7H4v14zM9 21V12h6v9" />
                        <circle cx="12" cy="16" r="1" />
                      </svg>
                      <strong>Room: ${esc(u.room_no)}</strong>
                    </div>
                    <div class="flex items-center space-x-2 whitespace-nowrap">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="7" width="16" height="14" />
                        <line x1="16" y1="3" x2="16" y2="7" />
                        <line x1="8" y1="3" x2="8" y2="7" />
                        <line x1="4" y1="11" x2="20" y2="11" />
                      </svg>
                      <strong>${formatDate(comp.createdAt)}</strong>
                    </div>
                    <div class="flex items-center space-x-2">
                      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.518 4.553a1 1 0 01-.217 1.036l-2.27 2.27a11.042 11.042 0 005.516 5.516l2.27-2.27a1 1 0 011.036-.217l4.553 1.518a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C7.82 21 3 16.18 3 10V5z" />
                      </svg>
                      <strong>${esc(u.phone)}</strong>
                    </div>
                  </div>

                  ${updatePanel}
                `;
                // ---- "Me too" badge: kitne aur students affected ----
                const affected = Array.isArray(comp.upvotes) ? comp.upvotes.length : 0;
                if (affected > 0) {
                    card.insertAdjacentHTML("beforeend",
                        `<div class="mt-4 text-center"><span class="inline-block bg-orange-100 text-orange-700 px-4 py-1 rounded-full font-semibold shadow">🔥 ${affected} more student(s) also affected</span></div>`);
                }
                card.insertAdjacentHTML("beforeend", feedbackSummary(comp));
                recentComplaints.appendChild(card);
            });
        }
                // ---------- CSV export: downloads the complaints currently shown (after search and filters) ----------
        function csvCell(v) {
            let s = String(v ?? "");
            // stop Excel from running text that starts with = + - @ as a formula
            if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
            return '"' + s.replace(/"/g, '""') + '"';
        }

        function csvDate(v) {
            return v ? new Date(v).toLocaleDateString("en-CA") : "";
        }

        function buildCsv(list) {
            const header = ["Title", "Category", "Status", "Priority", "Student", "Room", "Hostel",
                            "Created", "Resolved", "Rating", "Times reopened", "Description"];
            const rows = list.map(c => {
                const u = c.user || {};
                return [c.title, c.category, c.status, c.priority || "", u.username || "", u.room_no || "",
                        c.hostel_no, csvDate(c.createdAt), csvDate(c.resolvedAt), c.rating || "",
                        Number(c.reopenCount) || 0, c.description];
            });
            return [header, ...rows].map(r => r.map(csvCell).join(",")).join("\r\n");
        }

        function downloadCsv() {
            const f = getFilters();
            const list = sortComplaints(complaints.filter(c => matchesFilters(c, f)), f.sort);
            if (list.length === 0) {
                alert("No complaints to export with the current filters.");
                return;
            }
            // \uFEFF makes Excel read the file as UTF-8 (Hindi and special characters stay correct)
            const blob = new Blob(["\uFEFF" + buildCsv(list)], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "complaints-" + new Date().toLocaleDateString("en-CA") + ".csv";
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        const csvBar = document.createElement("div");
        csvBar.className = "flex justify-end w-full max-w-4xl px-6 mt-2";
        csvBar.innerHTML = `<button type="button" class="bg-green-600 text-white px-4 py-2 rounded-lg shadow font-semibold hover:bg-green-700">&#11015; Download CSV</button>`;
        csvBar.querySelector("button").addEventListener("click", downloadCsv);
        recentComplaints.parentNode.insertBefore(csvBar, recentComplaints);
        watchFilters(renderComplaints);
        renderComplaints();
    </script>

    <footer class="text-center text-gray-500 py-4">
        Developed by Harsh Kumar Singh | GL Bajaj Institute of Technology &amp; Management, Greater Noida
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>

    <% if (typeof message !== "undefined" && message) { %>
    <script>
        window.onload = function () {
            alert(<%- JSON.stringify(message).replace(/</g, "\\u003c") %>);
        }
    </script>
    <% } %>

</body>
</html>
