<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Register | GLBITM Hostel Complaint Portal</title>
  <link rel="stylesheet" href="/theme.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

    a.btn.btn-primary, a.btn.btn-primary:hover { color: #0e1320; }
    a.btn.btn-ghost, a.btn.btn-ghost:hover { color: var(--text); }

    .topbar { border-bottom: 1px solid var(--border); }
    .topbar .wrap { display: flex; align-items: center; gap: 32px; height: 84px; }
    .topbar img { height: 56px; width: auto; object-fit: contain; display: block; }
    .topbar nav { display: flex; gap: 28px; }
    .topbar nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.95rem; padding: 6px 0; border-bottom: 2px solid transparent; }
    .topbar nav a:hover { color: var(--text); }
    .topbar nav a.on { color: var(--text); border-bottom-color: var(--accent); }
    .topbar .actions { margin-left: auto; display: flex; gap: 10px; }

    .hero { position: relative; overflow: hidden; }
    .hero::before { content: ""; position: absolute; right: -140px; top: -120px; width: 460px; height: 460px; border-radius: 50%; border: 1px solid var(--border); opacity: 0.7; }
    .hero::after { content: ""; position: absolute; left: -90px; bottom: -110px; width: 260px; height: 260px; border-radius: 50%; border: 1px solid var(--border); opacity: 0.6; }
    .hero .wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; padding-top: 56px; padding-bottom: 72px; }
    .hero h1 { font-size: clamp(2.4rem, 4.4vw, 3.8rem); line-height: 1.05; margin: 24px 0 20px; }
    .hero h1 em { font-style: normal; color: var(--accent); }
    .hero p.lead { color: var(--muted); font-size: 1.1rem; max-width: 460px; margin: 0 0 32px; }
    .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .steps li { display: flex; gap: 14px; align-items: baseline; color: var(--muted); }
    .steps b { font-family: var(--font-head); color: var(--accent); min-width: 28px; }

    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; }
    .card h2 { font-size: 1.6rem; margin: 0 0 4px; }
    .card .sub { margin: 0; color: var(--muted); font-size: 0.95rem; }
    .card .field { border-color: #44516f; }
    .card .field::placeholder { color: #8590a8; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; margin-top: 22px; }
    .grid .full { grid-column: 1 / -1; }
    .hint { font-size: 0.8rem; color: var(--muted); margin-top: 6px; }
    .pw { position: relative; }
    .pw .field { padding-right: 64px; }
    .pw button { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: 0; color: var(--muted); font: 600 0.8rem var(--font-body); cursor: pointer; padding: 6px 8px; }
    .pw button:hover { color: var(--text); }
    .alert { margin-top: 16px; padding: 10px 14px; border-radius: 10px; font-size: 0.9rem; color: #ff8a94; background: rgba(240, 97, 109, 0.12); border: 1px solid rgba(240, 97, 109, 0.4); }
    .card .foot { margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.9rem; color: var(--muted); display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }

    .pagefoot { border-top: 1px solid var(--border); padding: 24px 0; text-align: center; color: var(--muted); font-size: 0.88rem; line-height: 1.7; }
    .pagefoot strong { color: var(--text); font-weight: 600; }

    @media (max-width: 900px) {
      .topbar nav { display: none; }
      .hero .wrap { grid-template-columns: 1fr; gap: 32px; padding-top: 32px; padding-bottom: 48px; }
      .hero h1 { margin-top: 0; }
    }
    @media (max-width: 520px) {
      .topbar .wrap { height: 72px; gap: 12px; }
      .topbar img { height: 44px; }
      .topbar .actions .btn-primary { display: none; }
      .card { padding: 24px 20px; }
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body class="theme">

  <header class="topbar">
    <div class="wrap">
      <img src="/college-logo.png" alt="GLBITM logo" />
      <nav>
        <a href="/user/login">Home</a>
        <a href="/user/login#how">How it works</a>
        <a href="/admin/login">Warden login</a>
      </nav>
      <div class="actions">
        <a class="btn btn-ghost btn-sm" href="/user/login">Sign in</a>
        <a class="btn btn-primary btn-sm" href="/user/register">Join now</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div>
          <h1>One account.<br />Every hostel issue, <em>tracked</em>.</h1>
          <p class="lead">Takes a minute. You will log in with your email.</p>
          <ol class="steps">
            <li><b>01</b> Create your account</li>
            <li><b>02</b> Report a problem with a photo</li>
            <li><b>03</b> Follow it until the warden fixes it</li>
          </ol>
        </div>

        <form class="card" action="/user/register" method="POST">
          <h2>Create your account</h2>
          <p class="sub">Use the same details as your hostel record.</p>

          <% if (typeof message !== "undefined" && message) { %>
            <div class="alert" role="alert"><%= message %></div>
          <% } %>

          <div class="grid">
            <div class="full">
              <label class="label" for="userName">Full name</label>
              <input class="field" id="userName" name="userName" type="text" placeholder="Your name" autocomplete="name" />
            </div>

            <div class="full">
              <label class="label" for="email">Email</label>
              <input class="field" id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" />
              <div class="hint">You will log in with this email. Status updates are sent here too.</div>
            </div>

            <div class="full">
              <label class="label" for="phoneNumber">Phone number</label>
              <input class="field" id="phoneNumber" name="phoneNumber" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="10" placeholder="10-digit number" autocomplete="tel" />
            </div>

            <div>
              <label class="label" for="hostelNumber">Hostel</label>
              <select class="field" id="hostelNumber" name="hostelNumber">
                <option value="H1">H1</option>
                <option value="H2">H2</option>
                <option value="H3">H3</option>
                <option value="H4">H4</option>
              </select>
            </div>
            <div>
              <label class="label" for="roomNumber">Room number</label>
              <input class="field" id="roomNumber" name="roomNumber" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" placeholder="e.g. 214" autocomplete="off" />
            </div>

            <div class="full">
              <label class="label" for="password">Password</label>
              <div class="pw">
                <input class="field" id="password" name="password" type="password" placeholder="Choose a password (min 6 characters)" autocomplete="new-password" />
                <button type="button" id="togglePw">Show</button>
              </div>
            </div>
          </div>

          <button class="btn btn-primary btn-lg btn-block" style="margin-top:24px">Create account</button>

          <div class="foot">
            <span>Already registered? <a href="/user/login">Log in</a></span>
            <span>Warden? <a href="/admin/login">Admin login</a></span>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="pagefoot">
    <div class="wrap">
      Developed by <strong>Harsh Kumar Singh</strong><br />
      GL Bajaj Institute of Technology &amp; Management, Greater Noida
    </div>
  </footer>

  <script>
    var pw = document.getElementById("password");
    var tg = document.getElementById("togglePw");
    tg.addEventListener("click", function () {
      var show = pw.type === "password";
      pw.type = show ? "text" : "password";
      tg.textContent = show ? "Hide" : "Show";
    });
  </script>
</body>
</html>