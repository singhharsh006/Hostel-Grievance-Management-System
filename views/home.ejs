<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Recent complaints | GLBITM Hostel Complaint Portal</title>
  <link rel="stylesheet" href="/theme.css" />
</head>

<body class="theme">

  <%- include('partials/navbar', { active: 'home' }) %>

  <section class="dh">
    <div class="page dh-in">
      <div>
        <span class="dh-eyebrow">Student dashboard</span>
        <h1>Recent <em>complaints</em></h1>
        <p class="dh-lead">See what is broken in your hostel, back the issues that affect you too, and follow them until they are fixed.</p>
        <div class="dh-actions">
          <a class="btn btn-primary btn-lg" href="/complaint/add">New complaint</a>
          <a class="btn btn-ghost btn-lg" href="/complaint/myComplaints">My complaints</a>
        </div>
      </div>
      <div class="dh-stats">
        <div class="dh-stat accent"><b id="stOpen">0</b><span>Open in your hostel</span></div>
        <div class="dh-stat"><b id="stProg">0</b><span>In progress</span></div>
        <div class="dh-stat"><b id="stHigh">0</b><span>High or urgent</span></div>
        <div class="dh-stat"><b id="stVotes">0</b><span>Me too votes</span></div>
      </div>
    </div>
  </section>

  <main class="page dh-main">
    <div class="page-head">
      <div>
        <h2 class="dh-sub">Open in your hostel</h2>
        <p class="muted" id="subline"></p>
      </div>
      <div class="toolbar">
        <label class="label" for="categorySort" style="margin:0">Category</label>
        <select id="categorySort" class="field">
          <option value="all">All</option>
          <option value="water">Water</option>
          <option value="electricity">Electricity</option>
          <option value="network">Network</option>
          <option value="mess">Mess</option>
          <option value="washroom">Washroom</option>
          <option value="general">General</option>
        </select>
      </div>
    </div>

    <div id="recentComplaints" class="tickets"></div>
  </main>

  <%- include('partials/tips') %>

  <footer class="pagefoot">
    <div class="wrap">
      Developed by <strong>Harsh Kumar Singh</strong><br />
      GL Bajaj Institute of Technology &amp; Management, Greater Noida
    </div>
  </footer>

  <script>
    const user = <%- JSON.stringify(user || {}).replace(/</g, "\\u003c") %>;
    const complaints = <%- JSON.stringify(complaints || []).replace(/</g, "\\u003c") %>;
    const esc = s => String(s ?? "").replace(/[&<>"']/g, ch => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch]));
    const recentComplaints = document.getElementById("recentComplaints");

    const PRI = { urgent: "p-urgent", high: "p-high", medium: "p-medium", low: "p-low" };
    const svg = (d) => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg>';
    const ICON_USER = svg('<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>');
    const ICON_ROOM = svg('<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M10 21v-6h4v6"/>');
    const ICON_DATE = svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>');
    const THUMB = 'M7 10v12M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z';

    function renderComplaints(filterCategory = "all") {
      recentComplaints.innerHTML = "";

      const list = complaints.filter(
        c => filterCategory === "all" || String(c.category).toLowerCase() === filterCategory.toLowerCase()
      );

      document.getElementById("subline").textContent =
        list.length + " open complaint" + (list.length === 1 ? "" : "s") + (user.hostel_no ? " in " + user.hostel_no : "");

      if (list.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        const check = '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

        if (complaints.length === 0) {
          // no open complaints in the hostel at all
          empty.innerHTML = '<div class="empty-icon">' + check + '</div>'
            + '<h3>No recent complaints</h3>'
            + '<p>There are no open complaints in ' + esc(user.hostel_no || "your hostel") + ' right now. If something needs attention, you can raise a new complaint.</p>'
            + '<a class="btn btn-primary" href="/complaint/add">Add a complaint</a>';
        } else {
          // complaints exist, but none in the selected category
          empty.innerHTML = '<h3>No complaints in this category</h3>'
            + '<p>There ' + (complaints.length === 1 ? 'is 1 open complaint' : 'are ' + complaints.length + ' open complaints')
            + ' in other categories. Choose "All" to see them.</p>';
        }
        recentComplaints.appendChild(empty);
        return;
      }

      list.forEach(comp => {
        const owner = comp.user || {};
        const pri = String(comp.priority || "Medium");
        const priClass = PRI[pri.toLowerCase()] || "p-medium";
        const inProgress = comp.status === "in progress";

        const card = document.createElement("article");
        card.className = "ticket " + priClass;
        card.innerHTML = `
          <div class="ticket-top">
            <span class="badge badge-cat">${esc(comp.category)}</span>
            <span class="badge ${inProgress ? "badge-progress" : "badge-open"}">${inProgress ? "In progress" : "Open"}</span>
            <span class="pri">${esc(pri)} priority</span>
          </div>
          <h2>${esc(comp.title)}</h2>
          <p class="desc">${esc(comp.description)}</p>
          <div class="meta">
            <span>${ICON_USER}${esc(owner.username)}</span>
            <span>${ICON_ROOM}${esc(comp.hostel_no || user.hostel_no)} &middot; Room ${esc(owner.room_no)}</span>
            <span>${ICON_DATE}${new Date(comp.createdAt).toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", day: "2-digit", month: "short", year: "numeric" })}</span>
          </div>
        `;

        // ---- "Me too" ----
        const votes = Array.isArray(comp.upvotes) ? comp.upvotes.map(String) : [];
        if (comp.meTooCount === undefined) comp.meTooCount = votes.length;
        if (comp.meTooVoted === undefined) comp.meTooVoted = votes.includes(String(user.id));
        const isOwn = String(owner._id) === String(user.id);

        const foot = document.createElement("div");
        foot.className = "ticket-foot";

        if (isOwn) {
          const info = document.createElement("span");
          info.textContent = comp.meTooCount + " other student(s) affected";
          foot.appendChild(info);
        } else {
          const hint = document.createElement("span");
          hint.textContent = "Facing the same problem?";
          foot.appendChild(hint);

          const btn = document.createElement("button");
          btn.type = "button";

          const paint = () => {
            const icon = '<svg width="16" height="16" viewBox="0 0 24 24" fill="' + (comp.meTooVoted ? "currentColor" : "none") + '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="' + THUMB + '"/></svg>';
            btn.innerHTML = icon + "<span>Me too &middot; " + Number(comp.meTooCount) + "</span>";
            btn.className = "btn btn-sm " + (comp.meTooVoted ? "btn-primary" : "btn-ghost");
            btn.setAttribute("aria-pressed", String(!!comp.meTooVoted));
          };
          paint();

          btn.addEventListener("click", async () => {
            btn.disabled = true;
            try {
              const res = await fetch("/complaint/upvote/" + comp._id, { method: "POST" });
              const out = await res.json();
              if (out.ok) {
                comp.meTooVoted = out.voted;
                comp.meTooCount = out.count;
                paint();
              } else {
                alert(out.error || "Could not save your vote");
              }
            } catch (e) {
              alert("Network error, try again");
            }
            btn.disabled = false;
          });
          foot.appendChild(btn);
        }

        card.appendChild(foot);
        recentComplaints.appendChild(card);
      });
    }

    document.getElementById("categorySort").addEventListener("change", (e) => {
      renderComplaints(e.target.value);
    });

    renderComplaints();

    (function () {
      const set = (id, v) => { document.getElementById(id).textContent = v; };
      set("stOpen", complaints.length);
      set("stProg", complaints.filter(c => c.status === "in progress").length);
      set("stHigh", complaints.filter(c => c.priority === "High" || c.priority === "Urgent").length);
      set("stVotes", complaints.reduce((s, c) => s + (Array.isArray(c.upvotes) ? c.upvotes.length : 0), 0));
    })();
  </script>
</body>

</html>