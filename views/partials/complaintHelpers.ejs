<style>
  select {
    padding-right: 2.5rem !important;
    text-overflow: ellipsis;
  }
</style>
<script>
  // ---------- Safety: escape any user text before putting it in innerHTML ----------
  function esc(v) {
    return String(v == null ? "" : v)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // Only allow images from our own /uploads folder (old) or our Cloudinary account (new)
  function safeImg(p) {
    if (typeof p !== "string") return "";
    return p.indexOf("https://res.cloudinary.com/") === 0 || p.indexOf("/uploads/") === 0 ? p : "";
  }

  function formatDate(iso) {
    return new Date(iso).toLocaleDateString("en-IN", {
      timeZone: "Asia/Kolkata", day: "2-digit", month: "long", year: "numeric"
    });
  }

  // ---------- Category icons ----------
  function getCategoryIcon(category) {
    switch (category) {
      case "water":
        return `<svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2C8 7 5 10 5 14a7 7 0 0014 0c0-4-3-7-7-12z" /></svg>`;
      case "electricity":
        return `<svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`;
      case "network":
        return `<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5.05 12.55a8 8 0 0 1 13.9 0" /><path d="M8.46 15.16a4 4 0 0 1 7.07 0" /><path d="M12 18.5h.01" /></svg>`;
      case "mess":
        return `<svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4" /><path d="M9 12c1-2 5-2 4 1" /><path d="M10 14c0 1 3 1 3 0" /></svg>`;
      case "washroom":
        return `<svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><rect x="6" y="14" width="12" height="4" rx="2" ry="2" /><line x1="6" y1="14" x2="18" y2="14" /><line x1="9" y1="14" x2="9" y2="12" /><line x1="15" y1="14" x2="15" y2="12" /></svg>`;
      default:
        return `<svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /></svg>`;
    }
  }

  // ---------- Priority ----------
  const PRIORITY_RANK = { Urgent: 4, High: 3, Medium: 2, Low: 1 };
  const PRIORITY_STYLE = {
    Urgent: "bg-red-100 text-red-700 border-red-300",
    High: "bg-orange-100 text-orange-700 border-orange-300",
    Medium: "bg-yellow-100 text-yellow-700 border-yellow-300",
    Low: "bg-green-100 text-green-700 border-green-300"
  };
  function priorityOf(comp) {
    return PRIORITY_RANK[comp.priority] ? comp.priority : "Medium";
  }
  function priorityBadge(comp) {
    const p = priorityOf(comp);
    return `<span class="px-3 py-1 rounded-full border text-sm font-bold shadow ${PRIORITY_STYLE[p]}">${p} priority</span>`;
  }

  // ---------- Status ----------
  function statusPill(status) {
    if (status === "resolved")
      return `<span class="bg-green-100 text-green-700 px-4 py-1 rounded-full font-bold shadow">Resolved</span>`;
    if (status === "in progress")
      return `<span class="bg-blue-100 text-blue-700 px-4 py-1 rounded-full font-bold shadow">In progress</span>`;
    return `<span class="bg-gray-100 text-gray-700 px-4 py-1 rounded-full font-bold shadow">Not resolved</span>`;
  }

  // ---------- Photos + admin note ----------
  function photoBlock(comp) {
    const before = safeImg(comp.image);
    const after = safeImg(comp.resolutionImage);
    if (!before && !after) return "";
    const one = (src, label) => `
      <a href="${esc(src)}" target="_blank" rel="noopener" class="text-center">
        <img src="${esc(src)}" alt="${label}" loading="lazy" class="h-40 w-auto max-w-full rounded-lg border border-gray-200 object-cover" />
        <span class="block text-xs text-gray-500 mt-1">${label}</span>
      </a>`;
    return `<div class="flex flex-wrap justify-center gap-4 mb-6 px-4">
      ${before ? one(before, "Complaint photo") : ""}
      ${after ? one(after, "After resolution") : ""}
    </div>`;
  }

  function adminNoteBlock(comp) {
    if (!comp.adminNote) return "";
    return `<div class="mx-4 mb-6 bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm text-gray-700">
      <strong>Admin note:</strong> ${esc(comp.adminNote)}
    </div>`;
  }

  // ---------- Search / filter / sort ----------
  // selectClass = colour classes for the dropdowns (differs between student and admin pages)
  function buildFilterBar(selectClass, defaultSort) {
    const wrap = document.createElement("div");
    wrap.className = "w-full max-w-4xl px-6 mt-8";
    const sel = "border border-gray-300 rounded-lg px-4 py-2 shadow focus:outline-none focus:ring-2 focus:ring-blue-500 " + selectClass;
    const lbl = "text-sm font-semibold text-gray-700 mb-1";
    wrap.innerHTML = `
      <input id="searchBox" type="search" placeholder="Search by title, description, name or room..."
        class="w-full border border-gray-300 rounded-lg px-4 py-2 shadow mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <div class="flex flex-wrap justify-center items-end gap-4">
        <div class="flex flex-col"><label for="categoryFilter" class="${lbl}">Category</label>
          <select id="categoryFilter" class="${sel}">
            <option value="all">All</option>
            <option value="water">Water</option>
            <option value="electricity">Electricity</option>
            <option value="network">Network</option>
            <option value="mess">Mess</option>
            <option value="washroom">Washroom</option>
            <option value="general">General</option>
          </select></div>
        <div class="flex flex-col"><label for="statusFilter" class="${lbl}">Status</label>
          <select id="statusFilter" class="${sel}">
            <option value="all">All</option>
            <option value="not resolved">Not resolved</option>
            <option value="in progress">In progress</option>
            <option value="resolved">Resolved</option>
          </select></div>
        <div class="flex flex-col"><label for="priorityFilter" class="${lbl}">Priority</label>
          <select id="priorityFilter" class="${sel}">
            <option value="all">All</option>
            <option value="Urgent">Urgent</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
          </select></div>
        <div class="flex flex-col"><label for="sortBy" class="${lbl}">Sort by</label>
          <select id="sortBy" class="${sel}">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="priority">Highest priority</option>
            <option value="affected">Most affected</option>
          </select></div>
      </div>
      <p id="resultCount" class="text-center text-sm text-gray-500 mt-4"></p>`;
    wrap.querySelector("#sortBy").value = defaultSort;
    return wrap;
  }

  function getFilters() {
    return {
      q: document.getElementById("searchBox").value.trim().toLowerCase(),
      category: document.getElementById("categoryFilter").value,
      status: document.getElementById("statusFilter").value,
      priority: document.getElementById("priorityFilter").value,
      sort: document.getElementById("sortBy").value
    };
  }

  function watchFilters(onChange) {
    document.getElementById("searchBox").addEventListener("input", onChange);
    ["categoryFilter", "statusFilter", "priorityFilter", "sortBy"].forEach(id =>
      document.getElementById(id).addEventListener("change", onChange)
    );
  }

  function matchesFilters(comp, f) {
    if (f.category !== "all" && String(comp.category).toLowerCase() !== f.category) return false;
    if (f.status !== "all" && String(comp.status).toLowerCase() !== f.status) return false;
    if (f.priority !== "all" && priorityOf(comp) !== f.priority) return false;
    if (f.q) {
      const u = comp.user || {};
      const hay = [comp.title, comp.description, comp.category, comp.hostel_no, u.username, u.room_no, u.phone]
        .join(" ").toLowerCase();
      if (hay.indexOf(f.q) === -1) return false;
    }
    return true;
  }

  function sortComplaints(list, mode) {
    const time = c => new Date(c.createdAt).getTime();
    const votes = c => Array.isArray(c.upvotes) ? c.upvotes.length : 0;
    return list.slice().sort((a, b) => {
      if (mode === "priority") return PRIORITY_RANK[priorityOf(b)] - PRIORITY_RANK[priorityOf(a)] || time(a) - time(b);
      if (mode === "affected") return votes(b) - votes(a) || PRIORITY_RANK[priorityOf(b)] - PRIORITY_RANK[priorityOf(a)] || time(a) - time(b);
      if (mode === "oldest") return time(a) - time(b);
      return time(b) - time(a);
    });
  }

  function setResultCount(shown, total) {
    document.getElementById("resultCount").textContent = "Showing " + shown + " of " + total + " complaints";
  }
</script>